# Token do Cloudflare Tunnel gerado no painel Zero Trust:
# Zero Trust (one.dash.cloudflare.com) -> Networks -> Tunnels
TUNNEL_TOKEN=seu_tunnel_token_aqui

# Chave de API da OpenAI (opcional para processamento com modelos OpenAI):
OPENAI_API_KEY=sk-proj-sua-chave-aqui

# URL Base opcional (para endpoints compatíveis como Groq, OpenRouter ou vLLM):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
